<?xml version="1.0" encoding="UTF-8"?>
<project name="jutil" basedir="." default="build"
         xmlns:if="ant:if">

<description>
JUtil build file.
</description>
<property name="package" value="jutil" />
<property name="package_topdir" value="net/cscott/jutil" />
<property name="version" value="2.0" /> <!-- change version # here! -->
<property name="junit.version" value="6.1.3" />
<property name="jdoctest.version" value="2.1" />
<property name="rhino.version" value="1.9.2" />
<property name="errorprone.version" value="2.51.0" />
<property name="dataflow.version" value="3.41.0-eisop1" />

    <!-- define some variables for the script -->
    <target name="init">
      <!-- load the variable definitions from another file -->
      <property file="build.properties" />
      <!-- define other variables -->
      <property name="api_dir"            value="${basedir}/api"/>
      <property name="lib_dir"            value="${basedir}/lib"/>
      <property name="src_dir"            value="${basedir}/src"/>
      <property name="test_dir"           value="${basedir}/test"/>
      <property name="classes_dir"	value="${basedir}/bin"/>
      <property name="build_dir"	value="${basedir}/build"/>
      <property name="test_classes_dir"	value="${build_dir}/test-classes"/>
      <property name="jar.file"	value="${package}-${version}.jar"/>
      <!-- set the classpath -->
      <path id="classpath.path">
        <pathelement path="${classes_dir}"/>
      </path>
      <path id="jdoctest.path">
        <pathelement path="${lib_dir}/jdoctest-${jdoctest.version}.jar"/>
        <pathelement path="${lib_dir}/rhino-all-${rhino.version}.jar"/>
      </path>
      <path id="test.classpath.path">
        <path refid="classpath.path"/>
        <pathelement path="${test_classes_dir}"/>
        <pathelement path="${lib_dir}/junit-platform-console-standalone-${junit.version}.jar"/>
        <path refid="jdoctest.path"/>
      </path>
    </target>

    <!-- delete generated files -->
    <target name="clean" depends="init"
            description="Removes the generated class files and javadoc">
	<delete includeemptydirs="true">
	  <fileset dir="${classes_dir}" includes="**/*" excludes="README" />
	</delete>
	<delete dir="${api_dir}" />
	<delete dir="${build_dir}" />
	<delete file="${basedir}/${jar.file}" />
	<delete file="${basedir}/${package}-${version}.tar.gz" />
        <delete file="src/${package_topdir}/Version.java" />
    </target>

    <!-- make the version file -->
    <target name="chk-version"
	    description="Generates Version.java.tmp and sets the
			 version.uptodate property to false if it should
			 be moved to replace Version.java" >
      <copy file="src/${package_topdir}/Version.java.in"
            tofile="src/${package_topdir}/Version.java.tmp" >
        <filterset>
         <filter token="VERSION" value="${version}"/>
         <filter token="PACKAGE" value="${package}"/>
        </filterset>
      </copy>
      <condition property="version.uptodate">
	<filesmatch file1="src/${package_topdir}/Version.java"
		    file2="src/${package_topdir}/Version.java.tmp" />
      </condition>
    </target>
    <target name="move-version" depends="chk-version" unless="version.uptodate"
	    description="Renames Version.java.tmp iff it is different
			 from Version.java">
      <!-- be careful only to overwrite Verson.java if there are changes -->
      <move file="src/${package_topdir}/Version.java.tmp"
	    tofile="src/${package_topdir}/Version.java" />
    </target>
    <target name="version"
	    description="Generates Version.java with the correct
			 version number."
	    depends="move-version">
      <!-- clean up the temp file in any case -->
      <delete file="src/${package_topdir}/Version.java.tmp" />
    </target>
    <target name="echo-version" depends="init"
            description="Print the current version number." >
      <echo message="Current version of ${package} is: ${version}" />
    </target>

    <!-- compile the source code -->
    <target name="compile" depends="init,version"
            description="Compiles the code in ${src_dir} to ${classes_dir}">
	    <mkdir dir="${classes_dir}" />
	    <javac srcdir="${src_dir}"
		   destdir="${classes_dir}"
		   excludes=".git"
		   deprecation="on" release="21" debug="true"
		   includeantruntime="false">
		   <classpath refid="classpath.path" />
		   <compilerarg value="-Xlint:all,-this-escape" />
	    </javac>
    </target>

    <!-- check the code with Error Prone; see README.md for its jars -->
    <target name="errorprone" depends="init,version"
            description="Checks the code in ${src_dir} with Error Prone">
	    <property name="errorprone.jar"
		      value="${lib_dir}/error_prone_core-${errorprone.version}-with-dependencies.jar"/>
	    <property name="dataflow.jar"
		      value="${lib_dir}/dataflow-errorprone-${dataflow.version}.jar"/>
	    <fail message="Error Prone needs ${errorprone.jar} and ${dataflow.jar}; README.md says how to download them.">
	      <condition><not><and>
		<available file="${errorprone.jar}"/>
		<available file="${dataflow.jar}"/>
	      </and></not></condition>
	    </fail>
	    <!-- the classes are thrown away: the jar is built by 'compile' -->
	    <property name="errorprone_dir" value="${build_dir}/errorprone"/>
	    <delete dir="${errorprone_dir}" />
	    <mkdir dir="${errorprone_dir}" />
	    <!-- Error Prone runs inside javac, so javac must be forked to
	         open the compiler's internals to it. -->
	    <javac srcdir="${src_dir}"
		   destdir="${errorprone_dir}"
		   excludes=".git"
		   release="21" debug="true"
		   includeantruntime="false"
		   fork="yes">
		   <classpath refid="classpath.path" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED" />
		   <compilerarg value="-J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED" />
		   <compilerarg value="-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED" />
		   <compilerarg value="-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED" />
		   <compilerarg value="-XDcompilePolicy=simple" />
		   <compilerarg value="-XDaddTypeAnnotationsToSymbol=true" />
		   <compilerarg value="--should-stop=ifError=FLOW" />
		   <compilerarg value="-processorpath" />
		   <compilerarg path="${errorprone.jar}:${dataflow.jar}" />
		   <!-- Checks which are off, with their reasons:
		        ReferenceEquality: the trees, persistent nodes and
		          factories compare by identity on purpose.
		        ExposedPrivateType, NonApiType, PreferThrowsTag,
		        EffectivelyPrivate: changing these would change
		          the public API, or its documentation's style.
		        AssignmentExpression, UnnecessaryParentheses,
		        StatementSwitchToExpressionSwitch: style only.
		        InlineMeSuggester: @InlineMe needs a dependency.
		        InvalidBlockTag: it doesn't know JDoctest's
		          @doc.test. -->
		   <compilerarg value="-Xplugin:ErrorProne -Xep:ReferenceEquality:OFF -Xep:ExposedPrivateType:OFF -Xep:NonApiType:OFF -Xep:PreferThrowsTag:OFF -Xep:EffectivelyPrivate:OFF -Xep:AssignmentExpression:OFF -Xep:UnnecessaryParentheses:OFF -Xep:StatementSwitchToExpressionSwitch:OFF -Xep:InlineMeSuggester:OFF -Xep:InvalidBlockTag:OFF" />
		   <compilerarg value="-Xmaxwarns" />
		   <compilerarg value="10000" />
	    </javac>
    </target>

    <!-- compile the tests -->
    <target name="compile-tests" depends="compile"
            description="Compiles the tests in ${test_dir}">
	    <mkdir dir="${test_classes_dir}" />
	    <javac srcdir="${test_dir}"
		   destdir="${test_classes_dir}"
		   deprecation="on" release="21" debug="true"
		   includeantruntime="false">
		   <classpath refid="test.classpath.path" />
		   <compilerarg value="-Xlint:all,-this-escape" />
	    </javac>
    </target>

    <!-- run all tests -->
    <target name="test" depends="compile-tests,javadoc"
	    description="Runs the JUnit tests and the doctests">
      <junitlauncher printsummary="true" haltonfailure="true">
	<classpath refid="test.classpath.path" />
	<!-- the doctests which the javadoc target wrote to api/tests -->
	<test name="net.cscott.jdoctest.RerunJDoctests"
	      outputdir="${build_dir}">
	  <fork dir="${basedir}">
	    <jvmarg value="-ea:net.cscott..." />
	  </fork>
	  <listener type="legacy-plain" />
	</test>
	<testclasses outputdir="${build_dir}">
	  <fileset dir="${test_classes_dir}" includes="**/*Test.class" />
	  <fork>
	    <jvmarg value="-ea:net.cscott..." />
	  </fork>
	  <listener type="legacy-plain" />
	</testclasses>
      </junitlauncher>
    </target>

    <!-- run the javadoc tool on the source code -->
    <target name="chk-javadoc" depends="init" >
      <uptodate property="javadoc.notRequired"
                targetfile="${api_dir}/index.html">
        <srcfiles dir="${src_dir}" includes="net/**/*.java **/*.html" />
      </uptodate>
    </target>
    <target name="javadoc"
	    depends="compile,chk-javadoc" unless="javadoc.notRequired"
            description="Generates javadoc in ${api_dir}">
	<mkdir dir="${api_dir}" />
	<javadoc sourcepath="${src_dir}"
		 packagenames="net.cscott.*"
		 destdir="${api_dir}"
                 windowtitle="JUtil ${version} documentation"
		 doctitle="JUtil ${version} documentation"
                 header="JUtil ${version}"
		 source="21"
		 bottom="Copyright &#169; 1998-2026 C. Scott Ananian"
                 access="protected" nodeprecated="false"
                 author="true" use="true" version="true"
		 breakiterator="true" failonerror="true">
	  <!-- run the @doc.test examples, and save them in api/tests -->
	  <taglet name="net.cscott.jdoctest.JDoctest"
		  path="${lib_dir}/jdoctest-${jdoctest.version}.jar:${lib_dir}/rhino-all-${rhino.version}.jar:${classes_dir}"/>
	  <arg value="-J-Dnet.cscott.jdoctest.output=${api_dir}/tests" />
	  <arg value="-J-ea:net.cscott..." />
	  <arg value="-Xdoclint:all,-missing" />
	  <classpath refid="classpath.path" />
          <!-- javadoc links to the JDK API docs by default -->
	</javadoc>
    </target>

    <!-- export the project as a jar -->
    <target name="jar" depends="compile"
            description="Exports the project as a jar">
	<jar destfile="${basedir}/${jar.file}">
		<fileset dir="${classes_dir}" excludes="README" />
		<manifest>
		  <attribute name="Automatic-Module-Name"
			     value="net.cscott.jutil" />
		  <attribute name="Main-Class"
			     value="net.cscott.jutil.Version" />
		  <attribute name="Implementation-Title" value="JUtil" />
		  <attribute name="Implementation-Version" value="${version}" />
		  <attribute name="Implementation-Vendor"
			     value="C. Scott Ananian" />
		  <attribute name="Implementation-URL"
			     value="https://cscott.net/Projects/JUtil/" />
		</manifest>
	</jar>
    </target>

    <!-- most ant scripts have a build target -->
    <target name="build" depends="jar" description="Alias for jar target"/>

    <!-- bundle up all files for distribution -->
    <target name="dist" depends="jar,javadoc"
	    description="Builds the release tarball">
      <tar destfile="${package}-${version}.tar.gz" compression="gzip">
        <tarfileset dir="api" prefix="${package}-${version}/api" />
        <tarfileset dir="src" prefix="${package}-${version}/src"
                    includes="**/*.java **/*.html **/*.java.in" />
        <tarfileset dir="test" prefix="${package}-${version}/test" />
        <tarfileset dir="lib" prefix="${package}-${version}/lib" />
        <tarfileset dir="maven" prefix="${package}-${version}/maven" />
        <tarfileset dir="." prefix="${package}-${version}"
         includes="README.md AUTHORS HISTORY.md COPYING build.xml
                   ${jar.file}" />
      </tar>
    </target>

    <!-- Maven Central: the POM, sources and javadoc jars, signatures and
         checksums, laid out as a Maven repository and zipped into a
         bundle for upload to https://central.sonatype.com/ .
         Signing runs gpg; set gpg.keyname to choose the key, or
         skip.sign to build an unsigned bundle (for testing only: Maven
         Central rejects it). -->
    <target name="maven" depends="jar,javadoc"
	    description="Builds the Maven Central bundle">
      <property name="maven_dir" value="${build_dir}/maven" />
      <property name="main_dir"
		value="${maven_dir}/net/cscott/${package}/${version}" />
      <delete dir="${maven_dir}" />
      <mkdir dir="${main_dir}" />
      <copy file="maven/${package}.pom.in"
	    tofile="${main_dir}/${package}-${version}.pom">
        <filterset>
         <filter token="VERSION" value="${version}"/>
        </filterset>
      </copy>
      <copy file="${jar.file}" todir="${main_dir}" />
      <jar destfile="${main_dir}/${package}-${version}-sources.jar">
        <fileset dir="${src_dir}" includes="**/*.java **/*.html" />
      </jar>
      <jar destfile="${main_dir}/${package}-${version}-javadoc.jar">
        <fileset dir="${api_dir}" excludes="tests/**" />
      </jar>
      <!-- signatures and checksums -->
      <antcall target="maven-sign" />
      <checksum algorithm="MD5" fileext=".md5" forceoverwrite="yes">
        <fileset dir="${maven_dir}" includes="**/*.jar **/*.pom" />
      </checksum>
      <checksum algorithm="SHA-1" fileext=".sha1" forceoverwrite="yes">
        <fileset dir="${maven_dir}" includes="**/*.jar **/*.pom" />
      </checksum>
      <zip destfile="${package}-${version}-bundle.zip" basedir="${maven_dir}"
           includes="net/**" />
      <echo message="Upload ${package}-${version}-bundle.zip to https://central.sonatype.com/publishing" />
    </target>
    <target name="maven-sign" unless="skip.sign">
      <apply executable="gpg" failonerror="true" parallel="false">
        <arg value="--batch" />
        <arg value="--yes" />
        <arg value="--armor" />
        <arg value="--local-user=${gpg.keyname}" if:set="gpg.keyname" />
        <arg value="--detach-sign" />
        <srcfile />
        <fileset dir="${build_dir}/maven" includes="**/*.jar **/*.pom" />
      </apply>
    </target>

    <target name="release" depends="test,dist,maven"
	    description="Builds all release artifacts; use 'ant clean release'"/>
</project>
